// กฎ Firestore ของแอป: ทุก collection เปิดสิทธิ์เฉพาะกรณีที่ประกาศไว้ใน match
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ใช้ helper นี้เพื่อลดการเขียนเงื่อนไขตรวจบัญชีซ้ำในแต่ละ collection
    function signedIn() {
      return request.auth != null;
    }

    // เปิด enforcement หลังย้ายบัญชีเก่าแล้ว config นี้เขียนได้จาก backend เท่านั้น
    function securityEnabled(key) {
      return exists(/databases/$(database)/documents/app_config/security) &&
        get(/databases/$(database)/documents/app_config/security).data.get(key, false) == true;
    }
    function verifiedMember() {
      return signedIn() && (!securityEnabled('verificationRequired') ||
        request.auth.token.get('email_verified', false) == true ||
        (exists(/databases/$(database)/documents/account_state/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/account_state/$(request.auth.uid)).data.get('verificationGraceUntil', request.time) > request.time));
    }
    function notBlocked(peer) {
      return signedIn() && (peer == request.auth.uid ||
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(peer)) &&
         !exists(/databases/$(database)/documents/users/$(peer)/blocks/$(request.auth.uid))));
    }
    function canPost() {
      return verifiedMember() && (!exists(/databases/$(database)/documents/account_state/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/account_state/$(request.auth.uid)).data.get('postingSuspendedUntil', request.time) <= request.time) &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('privacyMigrationTarget', null) == null);
    }
    function canPostInGroup(groupId) {
      let key = groupId + '_' + request.auth.uid;
      return canPost() && (!exists(/databases/$(database)/documents/group_account_state/$(key)) ||
        get(/databases/$(database)/documents/group_account_state/$(key)).data.get('postingSuspendedUntil', request.time) <= request.time);
    }
    // บัญชีเดิมมีเวลาย้ายมาแอปรุ่นใหม่ แต่โทษพักโพสต์ยังบังคับเสมอ
    function clientUpgradeGrace() {
      return signedIn() && exists(/databases/$(database)/documents/account_state/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/account_state/$(request.auth.uid)).data.get('clientUpgradeGraceUntil', request.time) > request.time;
    }
    function validWriteTicket(path, itemId) {
      let key = request.auth.uid + '_' + itemId;
      let ticket = /databases/$(database)/documents/write_tickets/$(key);
      return !securityEnabled('writeTicketsRequired') || clientUpgradeGrace() ||
        (exists(ticket) && !existsAfter(ticket) && get(ticket).data.uid == request.auth.uid &&
         get(ticket).data.targetPath == path && get(ticket).data.expiresAt > request.time);
    }
    // จำกัดจำนวนแท็กใน Rules; สิทธิ์ผู้ถูกแท็กตรวจซ้ำโดย reserveWrite ฝั่ง Admin SDK
    function validTaggedUserIds(data) {
      let ids = data.get('taggedUserIds', []);
      return ids is list && ids.size() <= 10 && !(request.auth.uid in ids) &&
        (ids.size() < 1 || (ids[0] is string && ids[0].size() > 0 && ids[0].size() <= 160)) &&
        (ids.size() < 2 || (ids[1] is string && ids[1].size() > 0 && ids[1].size() <= 160)) &&
        (ids.size() < 3 || (ids[2] is string && ids[2].size() > 0 && ids[2].size() <= 160)) &&
        (ids.size() < 4 || (ids[3] is string && ids[3].size() > 0 && ids[3].size() <= 160)) &&
        (ids.size() < 5 || (ids[4] is string && ids[4].size() > 0 && ids[4].size() <= 160)) &&
        (ids.size() < 6 || (ids[5] is string && ids[5].size() > 0 && ids[5].size() <= 160)) &&
        (ids.size() < 7 || (ids[6] is string && ids[6].size() > 0 && ids[6].size() <= 160)) &&
        (ids.size() < 8 || (ids[7] is string && ids[7].size() > 0 && ids[7].size() <= 160)) &&
        (ids.size() < 9 || (ids[8] is string && ids[8].size() > 0 && ids[8].size() <= 160)) &&
        (ids.size() < 10 || (ids[9] is string && ids[9].size() > 0 && ids[9].size() <= 160));
    }
    // รายชื่อที่บันทึกต้องตรงกับ ticket ที่ backend ออก และใช้ ticket ได้ครั้งเดียว
    function validTagTicket(path, itemId, data) {
      let ticket = /databases/$(database)/documents/write_tickets/$(request.auth.uid + '_' + itemId);
      let ids = data.get('taggedUserIds', []);
      return ids.size() == 0 ||
        (exists(ticket) && !existsAfter(ticket) && get(ticket).data.uid == request.auth.uid &&
         get(ticket).data.targetPath == path && get(ticket).data.taggedUserIds == ids &&
         get(ticket).data.expiresAt > request.time);
    }

    match /app_config/{name} { allow read: if signedIn(); allow write: if false; }
    match /account_state/{uid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    match /group_account_state/{key} { allow read: if signedIn() && resource.data.get('uid', '') == request.auth.uid; allow write: if false; }
    match /write_tickets/{key} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if false;
    }
    match /block_edges/{edgeId} {
      // The app checks both directional edge IDs, including missing edges, so
      // a member can tell whether they block each other before tagging.
      allow get: if signedIn() &&
        (edgeId.matches('^' + request.auth.uid + '_.*$') ||
         edgeId.matches('^.*_' + request.auth.uid + '$'));
      allow list: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if verifiedMember() && request.resource.data.actorId == request.auth.uid &&
        edgeId == request.auth.uid + '_' + request.resource.data.targetId &&
        request.resource.data.targetId != request.auth.uid &&
        request.resource.data.keys().hasOnly(['actorId', 'targetId', 'participants', 'createdAt']) &&
        request.resource.data.participants == [request.auth.uid, request.resource.data.targetId] &&
        request.resource.data.createdAt == request.time &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(request.resource.data.targetId));
      allow delete: if signedIn() && resource.data.actorId == request.auth.uid;
      allow update: if false;
    }
    // เคสให้ดูได้เฉพาะเจ้าของโพสต์และเจ้าของกลุ่ม ไม่เผย UID ของผู้รายงาน
    match /moderation_cases/{caseId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.groupOwnerId == request.auth.uid);
      allow write: if false;
    }
    match /moderation_archives/{caseId} {
      allow read: if signedIn() && (resource.data.ownerId == request.auth.uid || resource.data.groupOwnerId == request.auth.uid);
      allow write: if false;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function isApprovedFollower(userId) {
      return signedIn() && exists(
        /databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)
      );
    }

    function isPrivateProfile(userId) {
      let data = get(/databases/$(database)/documents/users/$(userId)).data;
      return data.get('privacyMigrationTarget',
        data.get('privacyTarget', data.get('isPrivate', false))) == true;
    }

    // During a privacy migration, the owner updates every post snapshot first.
    function expectedPostPrivacy(userId) {
      let data = get(/databases/$(database)/documents/users/$(userId)).data;
      return data.get('privacyMigrationTarget', isPrivateProfile(userId));
    }

    function canReadPostData(postData) {
      let visibility = postData.get('visibility', 'public');
      return signedIn() && (
        isAdmin() || postData.userId == request.auth.uid ||
        // โพสต์เฉพาะฉันไม่เปิดให้ผู้ติดตาม ส่วนโพสต์ทั่วไปยึดสิทธิ์โปรไฟล์
        (visibility in ['public', 'followers'] &&
         (isApprovedFollower(postData.userId) ||
          (visibility == 'public' &&
           postData.get('authorIsPrivate', false) != true &&
           !isPrivateProfile(postData.userId))))
      );
    }

    function validPostVisibility(postData) {
      // Post visibility is selected per post and is independent from account privacy.
      return postData.visibility in ['public', 'private', 'followers'];
    }

    function validPostTags(tags) {
      return tags is list && tags.size() <= 5 &&
        (tags.size() < 1 || (tags[0] is string && tags[0].size() > 0 && tags[0].size() <= 150)) &&
        (tags.size() < 2 || (tags[1] is string && tags[1].size() > 0 && tags[1].size() <= 150)) &&
        (tags.size() < 3 || (tags[2] is string && tags[2].size() > 0 && tags[2].size() <= 150)) &&
        (tags.size() < 4 || (tags[3] is string && tags[3].size() > 0 && tags[3].size() <= 150)) &&
        (tags.size() < 5 || (tags[4] is string && tags[4].size() > 0 && tags[4].size() <= 150));
    }

    function validProfileData(data, userId) {
      return data.uid == userId &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 60 &&
        data.displayNameLower is string && data.displayNameLower.size() <= 60 &&
        data.bio is string && data.bio.size() <= 160 && data.isPrivate is bool &&
        data.createdAt is timestamp &&
        (!('coverPath' in data) || (data.coverPath is string && data.coverPath.matches('profile_covers/' + userId + '/[^/]+'))) &&
        (!('privacyTarget' in data) || data.privacyTarget is bool) &&
        (!('privacyMigrationTarget' in data) || data.privacyMigrationTarget is bool) &&
        (!('avatarPrivateSecured' in data) || data.avatarPrivateSecured is bool) &&
        (!('avatarThumbPath' in data) ||
          (data.avatarThumbPath is string && data.avatarThumbPath.matches('profile_thumbnails/' + userId + '/[^/]+'))) &&
        (!('avatarPath' in data) ||
          (data.avatarPath is string && data.avatarPath.matches('profile_images/' + userId + '/[^/]+')));
    }

    function validPostUpdateTimestamps() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['visibility', 'authorIsPrivate']) ||
        (changed.hasAll(['updatedAt', 'editedAt']) &&
         request.resource.data.updatedAt == request.time &&
         request.resource.data.editedAt == request.time) ||
        (changed.hasOnly([
           'tags', 'visibility', 'mediaType', 'updatedAt', 'thumbnailPath',
           'authorIsPrivate'
         ]) &&
         request.resource.data.updatedAt == request.time &&
         request.resource.data.get('editedAt', null) == resource.data.get('editedAt', null));
    }

    // Admin ต้องได้รับ custom claim admin จากระบบที่เชื่อถือได้เท่านั้น

    // Ensure an optional video thumbnail stays inside the owning post folder.
    function hasValidPostThumbnail(data, postId) {
      return (data.mediaType == 'video' &&
          (!('thumbnailPath' in data) ||
           (data.thumbnailPath is string &&
            data.thumbnailPath.matches(
              'post_media/' + request.auth.uid + '/' + postId + '/[^/]+'
            )))) ||
        (data.mediaType != 'video' && !('thumbnailPath' in data));
    }

    // เอกสารโปรไฟล์อ่านได้เมื่อเข้าสู่ระบบ แต่แก้ได้เฉพาะเจ้าของ UID
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'displayNameLower', 'bio', 'isPrivate',
          'avatarPath', 'avatarThumbPath', 'avatarPrivateSecured', 'coverPath', 'createdAt', 'updatedAt'
        ]) && validProfileData(request.resource.data, userId) &&
        request.resource.data.createdAt == request.time &&
        (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time);
      allow delete: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'displayNameLower', 'isPrivate', 'avatarPath', 'avatarThumbPath', 'avatarPrivateSecured', 'coverPath', 'bio',
          'uid', 'createdAt', 'updatedAt', 'privacyTarget', 'privacyMigrationTarget'
        ]) &&
        validProfileData(request.resource.data, userId) &&
        ((resource.data.get('createdAt', null) is timestamp &&
          request.resource.data.createdAt == resource.data.createdAt) ||
         (!(resource.data.get('createdAt', null) is timestamp) && request.resource.data.createdAt == request.time)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) ||
         request.resource.data.updatedAt == request.time);

      match /blocks/{peer} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if verifiedMember() && request.auth.uid == userId && peer != userId &&
          exists(/databases/$(database)/documents/users/$(peer)) &&
          request.resource.data.keys().hasOnly(['uid', 'createdAt']) && request.resource.data.uid == peer &&
          request.resource.data.createdAt == request.time &&
          existsAfter(/databases/$(database)/documents/block_edges/$(userId + '_' + peer));
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }
      match /hidden_posts/{key} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create, update: if verifiedMember() && request.auth.uid == userId &&
          request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      // สมาชิกอ่านความสัมพันธ์ได้ แต่สร้าง/ลบได้เฉพาะความสัมพันธ์ของตนเอง
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create: if verifiedMember() && notBlocked(userId == request.auth.uid ? request.resource.data.uid : userId) &&
          followerUid != userId &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
          request.resource.data.uid == followerUid &&
          request.resource.data.createdAt == request.time &&
          ((request.auth.uid == followerUid &&
            !isPrivateProfile(userId)) ||
           (request.auth.uid == userId &&
            exists(/databases/$(database)/documents/users/$(userId)/follow_requests/$(followerUid))));
        allow delete: if signedIn() &&
          (request.auth.uid == followerUid || request.auth.uid == userId);
        allow update: if false;
      }

      match /following/{followedUid} {
        allow read: if signedIn();
        allow create: if verifiedMember() && notBlocked(userId == request.auth.uid ? request.resource.data.uid : userId) &&
          followedUid != userId &&
          exists(/databases/$(database)/documents/users/$(followedUid)) &&
          request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
          request.resource.data.uid == followedUid &&
          request.resource.data.createdAt == request.time &&
          ((request.auth.uid == userId &&
            !isPrivateProfile(followedUid)) ||
           (request.auth.uid == followedUid &&
            exists(/databases/$(database)/documents/users/$(followedUid)/follow_requests/$(userId))));
        allow delete: if signedIn() && (request.auth.uid == userId || (request.auth.uid == followedUid && !notBlocked(userId)));
        allow update: if false;
      }

      match /follow_requests/{requesterUid} {
        allow read: if signedIn() && (request.auth.uid == userId || request.auth.uid == requesterUid);
        allow create: if verifiedMember() && notBlocked(userId == request.auth.uid ? request.resource.data.uid : userId) && request.auth.uid == requesterUid &&
          requesterUid != userId &&
          isPrivateProfile(userId) &&
          !exists(/databases/$(database)/documents/users/$(userId)/followers/$(requesterUid)) &&
          request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
          request.resource.data.uid == requesterUid &&
          request.resource.data.createdAt == request.time;
        allow delete: if signedIn() &&
          (request.auth.uid == requesterUid || request.auth.uid == userId);
        allow update: if false;
      }
    }

    match /posts/{postId} {
      function groupShareStillVisible(grant) {
        let groupPath = /databases/$(database)/documents/groups/$(grant.targetId);
        let sharePath = /databases/$(database)/documents/groups/$(grant.targetId)/posts/$(grant.shareId);
        return exists(groupPath) &&
          get(groupPath).data.get('isDeleting', false) != true &&
          exists(/databases/$(database)/documents/groups/$(grant.targetId)/members/$(request.auth.uid)) &&
          exists(sharePath) &&
          get(sharePath).data.get('sharedPostId', '') == postId &&
          get(sharePath).data.authorId == resource.data.userId;
      }
      function chatShareStillVisible(grant) {
        let roomPath = /databases/$(database)/documents/conversations/$(grant.targetId);
        let sharePath = /databases/$(database)/documents/conversations/$(grant.targetId)/messages/$(grant.shareId);
        return exists(roomPath) && request.auth.uid in get(roomPath).data.participantIds &&
          exists(sharePath) && get(sharePath).data.type == 'post' &&
          get(sharePath).data.get('sharedPostId', '') == postId &&
          get(sharePath).data.senderId == resource.data.userId;
      }
      function sharedGrantIsValid(grant) {
        return resource.data.visibility == 'public' && resource.data.get('isDeleting', false) != true &&
          grant.ownerId == resource.data.userId && grant.expiresAt > request.time &&
          notBlocked(resource.data.userId) &&
          ((grant.destination == 'group' && groupShareStillVisible(grant)) ||
           (grant.destination == 'chat' && chatShareStillVisible(grant)));
      }
      function canReadSharedPost() {
        let grantPath = /databases/$(database)/documents/posts/$(postId)/share_access/$(request.auth.uid);
        return exists(grantPath) && sharedGrantIsValid(get(grantPath).data);
      }
      // ผู้ติดตามที่อนุมัติอ่านโพสต์ทั่วไปได้ทั้งบัญชีสาธารณะ/ส่วนตัว
      // โพสต์เฉพาะฉันยังอ่านได้เฉพาะเจ้าของและผู้ดูแลตามสิทธิ์เดิม
      // Single-document reads can use the full policy, including legacy docs.
      allow get: if canReadPostData(resource.data) || (signedIn() && canReadSharedPost());

      // Only the backend issues a grant after checking the destination.
      match /share_access/{readerId} {
        allow read, write: if false;
      }

      // Keep each list permission aligned with its matching query constraint.
      // Firestore evaluates a query as a whole and cannot filter out documents
      // that do not satisfy the read rules.
      allow list: if signedIn() && isAdmin();
      allow list: if signedIn() && resource.data.get('userId', '') == request.auth.uid;
      allow list: if signedIn() && resource.data.get('visibility', '') == 'public' &&
        resource.data.get('authorIsPrivate', false) == false;
      allow list: if signedIn() && resource.data.get('visibility', '') in ['public', 'followers'] &&
        isApprovedFollower(resource.data.get('userId', ''));

      allow create: if canPost() && validWriteTicket('posts/' + postId, postId) &&
        request.resource.data.keys().hasAll([
          'userId', 'authorName', 'content', 'tags', 'visibility',
          'createdAt', 'updatedAt', 'mediaType'
        ]) &&
        request.resource.data.keys().hasOnly([
          'userId', 'authorName', 'content', 'tags', 'visibility',
          'createdAt', 'updatedAt', 'mediaPath', 'mediaType', 'thumbnailPath',
          'authorIsPrivate', 'taggedUserIds'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.authorName is string &&
        request.resource.data.authorIsPrivate is bool &&
        // ป้องกัน snapshot privacy เก่าระหว่างบัญชีกำลังเปลี่ยนสถานะส่วนตัว
        request.resource.data.authorIsPrivate == expectedPostPrivacy(request.auth.uid) &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 1000 &&
        validPostTags(request.resource.data.tags) &&
        validTaggedUserIds(request.resource.data) && validTagTicket('posts/' + postId, postId, request.resource.data) &&
        (request.resource.data.content.size() > 0 || request.resource.data.mediaType != 'none') &&
        validPostVisibility(request.resource.data) &&
        request.resource.data.mediaType in ['none', 'image', 'video'] &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        ((request.resource.data.mediaType == 'none' &&
          !('mediaPath' in request.resource.data)) ||
         (request.resource.data.mediaType in ['image', 'video'] &&
          request.resource.data.mediaPath is string &&
          request.resource.data.mediaPath.matches(
            'post_media/' + request.auth.uid + '/' + postId + '/[^/]+'
          ))) &&
        hasValidPostThumbnail(request.resource.data, postId);

      // เจ้าของเปลี่ยนได้เฉพาะข้อมูลของโพสต์ ห้ามย้าย ownership
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.get('isDeleting', false) != true &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'content', 'tags', 'visibility', 'updatedAt', 'editedAt',
          'mediaPath', 'mediaType', 'thumbnailPath', 'authorIsPrivate', 'taggedUserIds'
        ]) &&
        validPostUpdateTimestamps() &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 1000 &&
        validPostTags(request.resource.data.tags) &&
        validTaggedUserIds(request.resource.data) &&
        (request.resource.data.get('taggedUserIds', []) == resource.data.get('taggedUserIds', []) ||
         validTagTicket('posts/' + postId, postId, request.resource.data)) &&
        (request.resource.data.content.size() > 0 || request.resource.data.mediaType != 'none' || resource.data.get('sharedPostId', null) is string) &&
        request.resource.data.authorIsPrivate is bool &&
        request.resource.data.authorIsPrivate == expectedPostPrivacy(request.auth.uid) &&
        validPostVisibility(request.resource.data) &&
        request.resource.data.mediaType in ['none', 'image', 'video'] &&
        ((request.resource.data.mediaType == 'none' &&
          !('mediaPath' in request.resource.data)) ||
         (request.resource.data.mediaType in ['image', 'video'] &&
          request.resource.data.mediaPath is string &&
          request.resource.data.mediaPath.matches(
            'post_media/' + request.auth.uid + '/' + postId + '/[^/]+'
          ))) &&
        hasValidPostThumbnail(request.resource.data, postId);

      // A resumable deletion closes writes to child collections before cleanup.
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleting', 'updatedAt']) &&
        request.resource.data.isDeleting == true && request.resource.data.updatedAt == request.time;

      allow delete: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // ความคิดเห็นสืบทอดสิทธิ์อ่านจากโพสต์; เพิ่มได้เฉพาะสมาชิกที่อ่านโพสต์ได้
      match /comments/{commentId} {
        function canReadPost() {
          return canReadPostData(get(/databases/$(database)/documents/posts/$(postId)).data);
        }

        allow read: if canReadPost();
        allow create: if canReadPost() &&
          get(/databases/$(database)/documents/posts/$(postId)).data.get('isDeleting', false) != true &&
          request.resource.data.keys().hasAll(['authorId', 'authorName', 'content', 'createdAt']) &&
          request.resource.data.keys().hasOnly(['authorId', 'authorName', 'content', 'createdAt']) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.authorName is string &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 1000 &&
          request.resource.data.createdAt == request.time;
        allow delete: if signedIn() &&
          (resource.data.authorId == request.auth.uid || isAdmin() ||
           get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid);
        allow update: if false;
      }

      // แต่ละบัญชีมี reaction ได้หนึ่งรายการต่อโพสต์ และจัดการได้เฉพาะของตัวเอง
      match /reactions/{reactorUid} {
        function canReadPost() {
          return canReadPostData(get(/databases/$(database)/documents/posts/$(postId)).data);
        }
        allow read: if canReadPost();
        allow create, update: if canReadPost() && request.auth.uid == reactorUid &&
          get(/databases/$(database)/documents/posts/$(postId)).data.get('isDeleting', false) != true &&
          request.resource.data.keys().hasOnly(['uid', 'reaction', 'updatedAt']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.reaction in [
            'like', 'love', 'haha', 'wow', 'sad', 'angry', 'dislike'
          ] &&
          request.resource.data.updatedAt == request.time;
        allow delete: if canReadPost() &&
          (request.auth.uid == reactorUid || isAdmin() ||
           get(/databases/$(database)/documents/posts/$(postId)).data.userId == request.auth.uid);
      }
    }

    match /post_reports/{reportId} {
      // ตรวจตำแหน่งและสิทธิ์ของโพสต์จริง ป้องกันผู้ใช้นอกกลุ่มส่งรายงานปลอมหรือสวมเจ้าของ
      function validReportTarget() {
        let data = request.resource.data;
        let groupId = data.get('groupId', null);
        return (groupId == null &&
          reportId == data.postId + '_' + request.auth.uid &&
          exists(/databases/$(database)/documents/posts/$(data.postId)) &&
          get(/databases/$(database)/documents/posts/$(data.postId)).data.userId == data.postOwnerId &&
          canReadPostData(get(/databases/$(database)/documents/posts/$(data.postId)).data)) ||
          (groupId is string && groupId.matches('[^/]+') &&
           reportId == 'group_' + groupId + '_' + data.postId + '_' + request.auth.uid &&
           exists(/databases/$(database)/documents/groups/$(groupId)) &&
           (isAdmin() || exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid))) &&
           exists(/databases/$(database)/documents/groups/$(groupId)/posts/$(data.postId)) &&
           get(/databases/$(database)/documents/groups/$(groupId)/posts/$(data.postId)).data.authorId == data.postOwnerId);
      }
      // รายงานเป็นข้อมูลส่วนตัว ผู้ใช้ส่งได้ แต่มีเพียงแอดมินที่เปิดดู/ปรับสถานะได้
      allow create: if verifiedMember() && (!securityEnabled('reportBackendRequired') || clientUpgradeGrace()) &&
        request.resource.data.keys().hasAll([
          'postId', 'postOwnerId', 'reporterUid', 'reason',
          'details', 'status', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'postId', 'postOwnerId', 'reporterUid', 'reason',
          'details', 'status', 'createdAt', 'groupId'
        ]) &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.postId is string &&
        request.resource.data.postOwnerId is string &&
        request.resource.data.postOwnerId != request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.reason is string &&
        request.resource.data.details is string &&
        request.resource.data.details.size() <= 300 &&
        request.resource.data.createdAt == request.time &&
        validReportTarget() &&
        !exists(/databases/$(database)/documents/post_reports/$(reportId));

      allow read: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedAt', 'reviewedBy'
        ]) &&
        request.resource.data.status in ['resolved', 'dismissed', 'removed'] &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    match /conversations/{conversationId} {
      // ใช้ participantIds กลางเพื่อตรวจสมาชิกก่อนเปิดห้องหรือเปลี่ยนสถานะอ่าน
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participantIds;
      }
      function otherParticipantUid() {
        let participantIds = resource.data.participantIds;
        return participantIds[0] == request.auth.uid
          ? participantIds[1]
          : participantIds[0];
      }
      // ซ่อน/เปิดห้องได้เฉพาะสถานะของตนเอง และต้องเก็บสถานะของคู่สนทนาไว้
      function canChangeOwnHiddenState() {
        let participantIds = resource.data.participantIds;
        let oldHidden = resource.data.get('hiddenFor', {}) is map ? resource.data.get('hiddenFor', {}) : {};
        let newHidden = request.resource.data.get('hiddenFor', {});
        return newHidden is map &&
          newHidden.keys().hasOnly(participantIds) &&
          newHidden.get(request.auth.uid, false) is bool &&
          newHidden.get(otherParticipantUid(), false) ==
            oldHidden.get(otherParticipantUid(), false);
      }
      function validNewConversationState(ids) {
        let data = request.resource.data;
        let peer = ids[0] == request.auth.uid ? ids[1] : ids[0];
        return data.participantNames is map &&
          data.participantNames.keys().hasAll(ids) &&
          data.participantNames.keys().hasOnly(ids) &&
          data.participantNames[ids[0]] is string &&
          data.participantNames[ids[1]] is string &&
          data.participantNames[ids[0]].size() > 0 &&
          data.participantNames[ids[0]].size() <= 60 &&
          data.participantNames[ids[1]].size() > 0 &&
          data.participantNames[ids[1]].size() <= 60 &&
          data.unreadCounts is map && data.unreadCounts.keys().hasAll(ids) &&
          data.unreadCounts.keys().hasOnly(ids) &&
          data.unreadCounts[ids[0]] == 0 && data.unreadCounts[ids[1]] == 0 &&
          data.lastReadAt is map &&
          data.lastReadAt.keys().hasOnly([request.auth.uid]) &&
          data.lastReadAt.get(request.auth.uid, null) == request.time &&
          isApprovedFollower(peer);
      }
      function canUpdateOwnReadState() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let oldUnread = resource.data.get('unreadCounts', {}) is map ? resource.data.get('unreadCounts', {}) : {};
        let newUnread = request.resource.data.get('unreadCounts', {});
        let oldRead = resource.data.get('lastReadAt', {}) is map ? resource.data.get('lastReadAt', {}) : {};
        let newRead = request.resource.data.get('lastReadAt', {});
        return changed.hasAny(['unreadCounts', 'lastReadAt']) &&
          changed.hasOnly(['unreadCounts', 'lastReadAt', 'updatedAt']) &&
          newUnread is map && newUnread.keys().hasOnly(resource.data.participantIds) &&
          newUnread.get(request.auth.uid, 0) == 0 &&
          newUnread.get(otherParticipantUid(), 0) ==
            oldUnread.get(otherParticipantUid(), 0) &&
          newRead is map && newRead.keys().hasOnly(resource.data.participantIds) &&
          newRead.get(request.auth.uid, null) == request.time &&
          newRead.get(otherParticipantUid(), null) ==
            oldRead.get(otherParticipantUid(), null) &&
          request.resource.data.updatedAt == request.time;
      }
      // ตรวจสรุปห้องเทียบกับข้อความใหม่หลัง batch ผ่าน getAfter()
      // เพื่อให้ข้อความ ตัวอย่างล่าสุด และตัวนับ unread ถูกบันทึกด้วยกันอย่างถูกต้อง
      function canUpdateForNewMessage() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let oldUnread = resource.data.get('unreadCounts', {}) is map ? resource.data.get('unreadCounts', {}) : {};
        let newUnread = request.resource.data.get('unreadCounts', {});
        let oldRead = resource.data.get('lastReadAt', {}) is map ? resource.data.get('lastReadAt', {}) : {};
        let newRead = request.resource.data.get('lastReadAt', {});
        let messageId = request.resource.data.get('lastMessageId', '');
        let safeMessageId = messageId is string && messageId.matches('[^/]+') ? messageId : '__invalid_message_id__';
        let messagePath = /databases/$(database)/documents/conversations/$(conversationId)/messages/$(safeMessageId);
        // Unchanged values do not appear in affectedKeys, even when a client
        // explicitly writes them. Validate the resulting values instead.
        return changed.hasOnly([
            'lastMessageText', 'lastMessageType', 'lastMessageSenderId',
            'lastMessageAt', 'lastMessageId', 'unreadCounts', 'lastReadAt',
            'hiddenFor', 'updatedAt'
          ]) &&
          request.resource.data.lastMessageId is string &&
          messageId != resource.data.get('lastMessageId', '') &&
          !exists(messagePath) &&
          existsAfter(messagePath) &&
          getAfter(messagePath).data.senderId == request.auth.uid &&
          getAfter(messagePath).data.createdAt == request.time &&
          getAfter(messagePath).data.type == request.resource.data.lastMessageType &&
          getAfter(messagePath).data.type in ['text', 'image', 'video'] &&
          getAfter(messagePath).data.text is string &&
          getAfter(messagePath).data.text.size() <= 2000 &&
          request.resource.data.lastMessageText is string &&
          request.resource.data.lastMessageText.size() <= 2000 &&
          request.resource.data.lastMessageText ==
            (getAfter(messagePath).data.text.size() > 0
              ? getAfter(messagePath).data.text
              : getAfter(messagePath).data.type == 'image'
                ? 'ส่งรูปภาพให้คุณ'
                : getAfter(messagePath).data.type == 'video'
                  ? 'ส่งวิดีโอให้คุณ'
                  : '') &&
          request.resource.data.lastMessageSenderId == request.auth.uid &&
          request.resource.data.lastMessageAt == request.time &&
          newUnread is map && newUnread.keys().hasOnly(resource.data.participantIds) &&
          newUnread.get(request.auth.uid, 0) == 0 &&
          newUnread.get(otherParticipantUid(), 0) ==
            (oldUnread.get(otherParticipantUid(), 0) is int && oldUnread.get(otherParticipantUid(), 0) >= 0
              ? oldUnread.get(otherParticipantUid(), 0) : 0) + 1 &&
          newRead is map && newRead.keys().hasOnly(resource.data.participantIds) &&
          newRead.get(request.auth.uid, null) == request.time &&
          newRead.get(otherParticipantUid(), null) ==
            oldRead.get(otherParticipantUid(), null) &&
          request.resource.data.hiddenFor is map &&
          request.resource.data.hiddenFor.keys().hasOnly(resource.data.participantIds) &&
          request.resource.data.hiddenFor.get(request.auth.uid, false) == false &&
          request.resource.data.hiddenFor.get(otherParticipantUid(), false) == false &&
          request.resource.data.updatedAt == request.time;
      }
      // อนุญาตให้เจ้าของยกเลิกข้อความล่าสุด และต้องตรงกับข้อความที่เปลี่ยนเป็น deleted
      // ไม่บังคับ preview เปลี่ยนค่า เพราะข้อความเดิมอาจเป็นคำว่า "ยกเลิกข้อความนี้" อยู่แล้ว
      function canUpdateForUnsentLatestMessage() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let messageId = resource.data.get('lastMessageId', '');
        let safeMessageId = messageId is string && messageId.matches('[^/]+') ? messageId : '__invalid_message_id__';
        let messagePath = /databases/$(database)/documents/conversations/$(conversationId)/messages/$(safeMessageId);
        return changed.hasOnly(['lastMessageText', 'lastMessageType', 'updatedAt']) &&
          request.resource.data.lastMessageId == resource.data.lastMessageId &&
          existsAfter(messagePath) &&
          getAfter(messagePath).data.senderId == request.auth.uid &&
          getAfter(messagePath).data.type == 'deleted' &&
          getAfter(messagePath).data.text == 'ยกเลิกข้อความนี้' &&
          getAfter(messagePath).data.deletedAt == request.time &&
          request.resource.data.lastMessageType == 'deleted' &&
          request.resource.data.lastMessageText == 'ยกเลิกข้อความนี้' &&
          request.resource.data.updatedAt == request.time;
      }
      function canUpdateOwnHiddenStateOnly() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        // เปิดห้องที่มองเห็นอยู่แล้วอาจเขียน hiddenFor=false ซ้ำ จึงไม่บังคับว่าค่าต้องเปลี่ยน
        return changed.hasOnly(['hiddenFor', 'updatedAt']) &&
          canChangeOwnHiddenState() &&
          request.resource.data.updatedAt == request.time;
      }
      // ลบประวัติเฉพาะบัญชีตัวเอง โดยไม่เปลี่ยนสถานะอ่านหรือประวัติของอีกฝ่าย
      function canClearOwnConversation() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let ids = resource.data.participantIds;
        let oldCleared = resource.data.get('clearedAt', {}) is map ? resource.data.get('clearedAt', {}) : {};
        let newCleared = request.resource.data.get('clearedAt', {});
        let oldUnread = resource.data.get('unreadCounts', {}) is map ? resource.data.get('unreadCounts', {}) : {};
        let newUnread = request.resource.data.get('unreadCounts', {});
        let oldRead = resource.data.get('lastReadAt', {}) is map ? resource.data.get('lastReadAt', {}) : {};
        let newRead = request.resource.data.get('lastReadAt', {});
        return changed.hasAll(['clearedAt']) &&
          changed.hasOnly(['hiddenFor', 'clearedAt', 'unreadCounts', 'lastReadAt', 'updatedAt']) &&
          canChangeOwnHiddenState() &&
          request.resource.data.hiddenFor.get(request.auth.uid, false) == true &&
          newCleared is map && newCleared.keys().hasOnly(ids) &&
          newCleared.get(request.auth.uid, null) == request.time &&
          newCleared.get(otherParticipantUid(), null) == oldCleared.get(otherParticipantUid(), null) &&
          newUnread is map && newUnread.keys().hasOnly(ids) &&
          newUnread.get(request.auth.uid, -1) == 0 &&
          newUnread.get(otherParticipantUid(), 0) == oldUnread.get(otherParticipantUid(), 0) &&
          newRead is map && newRead.keys().hasOnly(ids) &&
          newRead.get(request.auth.uid, null) == request.time &&
          newRead.get(otherParticipantUid(), null) == oldRead.get(otherParticipantUid(), null) &&
          request.resource.data.updatedAt == request.time;
      }
      // Transactions that create a deterministic conversation first read its
      // document. Allow signed-in users to read a missing ID so they can create
      // it; existing conversations remain visible to participants only.
      allow get: if signedIn() &&
        (!exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
         isParticipant());
      allow list: if isParticipant();
      allow create: if verifiedMember() && notBlocked(request.resource.data.participantIds[0]) && notBlocked(request.resource.data.participantIds[1]) &&
        request.resource.data.keys().hasAll(['participantIds','participantNames','unreadCounts','lastReadAt','createdAt','updatedAt']) &&
        request.resource.data.keys().hasOnly(['participantIds','participantNames','unreadCounts','lastReadAt','createdAt','updatedAt']) &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds[0] is string &&
        request.resource.data.participantIds[1] is string &&
        request.resource.data.participantIds[0] != request.resource.data.participantIds[1] &&
        request.resource.data.participantIds.hasAny([request.auth.uid]) &&
        validNewConversationState(request.resource.data.participantIds) &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[0])) &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[1])) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isParticipant() &&
        request.resource.data.participantIds == resource.data.participantIds &&
        (canUpdateOwnReadState() ||
         canUpdateForNewMessage() ||
         canUpdateForUnsentLatestMessage() ||
         canClearOwnConversation() ||
         canUpdateOwnHiddenStateOnly());
      allow delete: if false;

      match /messages/{messageId} {
        // ข้อความอ่านได้เฉพาะสมาชิก; สร้างได้โดยผู้ส่งที่ล็อกอินและอยู่ในห้อง
        function parentHasParticipant() {
          return signedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        }
        function canReadOwnHistory() {
          let cleared = get(/databases/$(database)/documents/conversations/$(conversationId)).data.get('clearedAt', {});
          return !(cleared is map) || !(request.auth.uid in cleared) ||
            (cleared[request.auth.uid] is timestamp &&
             resource.data.createdAt > cleared[request.auth.uid]);
        }
        function updatesConversationSummary() {
          let parent = getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return parent.lastMessageId == messageId &&
            parent.lastMessageSenderId == request.auth.uid &&
            parent.lastMessageAt == request.time;
        }
        allow read: if parentHasParticipant() && canReadOwnHistory();
        allow create: if verifiedMember() && parentHasParticipant() && notBlocked(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds[0]) && notBlocked(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds[1]) && validWriteTicket('conversations/' + conversationId + '/messages/' + messageId, messageId) && updatesConversationSummary() &&
          request.resource.data.keys().hasAll(['senderId','type','text','createdAt']) &&
          request.resource.data.keys().hasOnly(['senderId','type','text','mediaPath','createdAt']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.type in ['text','image','video','post'] &&
          request.resource.data.text is string && request.resource.data.text.size() <= 2000 &&
          (request.resource.data.type != 'text' || request.resource.data.text.size() > 0) &&
          request.resource.data.createdAt == request.time &&
          ((request.resource.data.type == 'text' && !('mediaPath' in request.resource.data)) ||
           (request.resource.data.type in ['image','video'] &&
            request.resource.data.mediaPath is string &&
            request.resource.data.mediaPath.matches('chat_media/' + conversationId + '/' + request.auth.uid + '/[^/]+')));
        allow update: if parentHasParticipant() &&
          resource.data.senderId == request.auth.uid &&
          resource.data.type in ['text','image','video','post'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'type','text','mediaPath','sharedPostId','deletedAt'
          ]) &&
          request.resource.data.type == 'deleted' &&
          request.resource.data.text == 'ยกเลิกข้อความนี้' &&
          !('mediaPath' in request.resource.data) && !('sharedPostId' in request.resource.data) &&
          request.resource.data.deletedAt == request.time;
        allow delete: if false;
      }
    }

    // แจ้งเตือนส่วนนี้ใช้กับกิจกรรมทางสังคม; ข้อความแชทนับ unread ใน conversation
    match /notifications/{notificationId} {
      function validNotificationBase() {
        return request.resource.data.keys().hasAll([
            'recipientId', 'actorId', 'actorName', 'type', 'body',
            'isRead', 'createdAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'recipientId', 'actorId', 'actorName', 'type', 'body',
            'postId', 'commentId', 'isRead', 'createdAt', 'groupId'
          ]) &&
          request.resource.data.recipientId is string &&
          request.resource.data.recipientId.matches('[^/]+') &&
          request.resource.data.recipientId != request.auth.uid &&
          request.resource.data.actorId == request.auth.uid &&
          request.resource.data.actorName is string &&
          request.resource.data.type in ['comment', 'like', 'follow'] &&
          request.resource.data.isRead == false &&
          request.resource.data.body is string &&
          request.resource.data.body.size() <= 2000 &&
          request.resource.data.createdAt == request.time;
      }
      function validCommentNotification() {
        return request.resource.data.type == 'comment' &&
          request.resource.data.postId is string &&
          request.resource.data.postId.matches('[^/]+') &&
          request.resource.data.commentId is string &&
          request.resource.data.commentId.matches('[^/]+') &&
          validCommentNotificationDetails(
            request.resource.data.postId,
            request.resource.data.commentId
          );
      }
      function validCommentNotificationDetails(postId, commentId) {
        let postPath = /databases/$(database)/documents/posts/$(postId);
        let commentPath = /databases/$(database)/documents/posts/$(postId)/comments/$(commentId);
        let post = get(postPath).data;
        let comment = get(commentPath).data;
        return exists(postPath) && exists(commentPath) &&
          post.userId is string &&
          canReadPostData(post) &&
          exists(/databases/$(database)/documents/users/$(post.userId)/followers/$(request.resource.data.recipientId)) &&
          notificationId == 'comment_' + request.resource.data.commentId + '_' + request.resource.data.recipientId &&
          comment.authorId == request.auth.uid &&
          comment.authorName == request.resource.data.actorName &&
          comment.content == request.resource.data.body;
      }
      function validLikeNotification() {
        return request.resource.data.type == 'like' &&
          request.resource.data.postId is string &&
          request.resource.data.postId.matches('[^/]+') &&
          !('commentId' in request.resource.data) &&
          validLikeNotificationDetails(request.resource.data.postId);
      }
      function validLikeNotificationDetails(postId) {
        let postPath = /databases/$(database)/documents/posts/$(postId);
        let reactionPath = /databases/$(database)/documents/posts/$(postId)/reactions/$(request.auth.uid);
        let post = get(postPath).data;
        let reaction = getAfter(reactionPath).data;
        return exists(postPath) && post.userId == request.resource.data.recipientId &&
          existsAfter(reactionPath) && reaction.uid == request.auth.uid &&
          reaction.reaction == 'like' && reaction.updatedAt == request.time;
      }
      function validFollowNotification() {
        let directFollowerPath = /databases/$(database)/documents/users/$(request.resource.data.recipientId)/followers/$(request.auth.uid);
        let directFollowingPath = /databases/$(database)/documents/users/$(request.auth.uid)/following/$(request.resource.data.recipientId);
        let acceptedFollowerPath = /databases/$(database)/documents/users/$(request.auth.uid)/followers/$(request.resource.data.recipientId);
        let acceptedFollowingPath = /databases/$(database)/documents/users/$(request.resource.data.recipientId)/following/$(request.auth.uid);
        let directFollower = getAfter(directFollowerPath).data;
        let directFollowing = getAfter(directFollowingPath).data;
        let acceptedFollower = getAfter(acceptedFollowerPath).data;
        let acceptedFollowing = getAfter(acceptedFollowingPath).data;
        return request.resource.data.type == 'follow' &&
          !('postId' in request.resource.data) &&
          !('commentId' in request.resource.data) &&
          ((existsAfter(directFollowerPath) && existsAfter(directFollowingPath) &&
            directFollower.uid == request.auth.uid &&
            directFollowing.uid == request.resource.data.recipientId) ||
           (existsAfter(acceptedFollowerPath) && existsAfter(acceptedFollowingPath) &&
            acceptedFollower.uid == request.resource.data.recipientId &&
            acceptedFollowing.uid == request.auth.uid));
      }
      // แจ้งเตือนกลุ่มส่งให้เจ้าของโพสต์ที่เป็นสมาชิก และต้องอ้างถึง Comment/Like จริงเท่านั้น
      function validGroupNotification() {
        let data = request.resource.data;
        let groupId = data.groupId;
        let postId = data.postId;
        let post = get(/databases/$(database)/documents/groups/$(groupId)/posts/$(postId)).data;
        return groupId is string && groupId.matches('[^/]+') && postId is string && postId.matches('[^/]+') &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)) &&
          exists(/databases/$(database)/documents/groups/$(groupId)/members/$(data.recipientId)) &&
          post.authorId == data.recipientId &&
          ((data.type == 'like' && !('commentId' in data) &&
            getAfter(/databases/$(database)/documents/groups/$(groupId)/posts/$(postId)/reactions/$(request.auth.uid)).data.reaction == 'like' &&
            getAfter(/databases/$(database)/documents/groups/$(groupId)/posts/$(postId)/reactions/$(request.auth.uid)).data.updatedAt == request.time) ||
           (data.type == 'comment' && data.commentId is string && data.commentId.matches('[^/]+') &&
            notificationId == 'group_comment_' + groupId + '_' + postId + '_' + data.commentId &&
            get(/databases/$(database)/documents/groups/$(groupId)/posts/$(postId)/comments/$(data.commentId)).data.authorId == request.auth.uid &&
            get(/databases/$(database)/documents/groups/$(groupId)/posts/$(postId)/comments/$(data.commentId)).data.authorName == data.actorName &&
            get(/databases/$(database)/documents/groups/$(groupId)/posts/$(postId)/comments/$(data.commentId)).data.content == data.body));
      }
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn() && validNotificationBase() &&
        ('groupId' in request.resource.data ? validGroupNotification() : (validCommentNotification() ||
         validLikeNotification() ||
         validFollowNotification()));
      allow update: if signedIn() && resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) && request.resource.data.isRead == true;
      allow delete: if false;
    }

    // Group metadata can be discovered after sign-in. Private posts and members
    // remain restricted to accepted members and the group owner.
    match /groups/{groupId} {
      function groupPath() {
        return /databases/$(database)/documents/groups/$(groupId);
      }
      function memberPath(memberUid) {
        return /databases/$(database)/documents/groups/$(groupId)/members/$(memberUid);
      }
      function requestPath(requesterUid) {
        return /databases/$(database)/documents/groups/$(groupId)/join_requests/$(requesterUid);
      }
      function isGroupOwner() {
        return signedIn() && exists(groupPath()) &&
          get(groupPath()).data.ownerId == request.auth.uid;
      }
      function isGroupManager() {
        return isGroupOwner() || isAdmin();
      }
      function isGroupMember() {
        return signedIn() &&
          exists(memberPath(request.auth.uid));
      }
      function publicGroup() {
        return exists(groupPath()) &&
          get(groupPath()).data.visibility == 'public';
      }
      // กลุ่มสาธารณะเปิดอ่านก่อนเข้าร่วม ส่วนการเขียนยังตรวจสมาชิกแยกต่างหาก
      function canReadGroupContent() {
        return signedIn() && (publicGroup() || isGroupMember() || isGroupManager());
      }
      function validCountIncrement() {
        let beforeCount = resource.data.get('memberCount', null);
        let afterCount = request.resource.data.get('memberCount', null);
        return afterCount is int &&
          ((beforeCount is int && afterCount == beforeCount + 1) ||
           (!(beforeCount is int) && afterCount > 0));
      }
      function validCountDecrement() {
        let beforeCount = resource.data.get('memberCount', null);
        let afterCount = request.resource.data.get('memberCount', null);
        return afterCount is int &&
          ((beforeCount is int && beforeCount > 0 && afterCount == beforeCount - 1) ||
           (!(beforeCount is int) && afterCount >= 0));
      }
      function validPublicJoinCountUpdate() {
        return signedIn() && publicGroup() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
          validCountIncrement() &&
          !exists(memberPath(request.auth.uid)) &&
          existsAfter(memberPath(request.auth.uid)) &&
          getAfter(memberPath(request.auth.uid)).data.uid == request.auth.uid;
      }
      function validMemberLeaveCountUpdate() {
        return signedIn() && request.auth.uid != resource.data.ownerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
          validCountDecrement() &&
          exists(memberPath(request.auth.uid)) &&
          !existsAfter(memberPath(request.auth.uid));
      }
      function validManagerCountUpdate() {
        return signedIn() && isGroupManager() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
          validCountIncrement();
      }
      function validIncrementForMember(memberUid) {
        let beforeCount = get(groupPath()).data.get('memberCount', null);
        let afterCount = getAfter(groupPath()).data.get('memberCount', null);
        return afterCount is int &&
          ((beforeCount is int && afterCount == beforeCount + 1) ||
           (!(beforeCount is int) && afterCount > 0)) &&
          !exists(memberPath(memberUid)) &&
          existsAfter(memberPath(memberUid)) &&
          getAfter(memberPath(memberUid)).data.uid == memberUid;
      }
      function validDecrementForMember(memberUid) {
        let beforeCount = get(groupPath()).data.get('memberCount', null);
        let afterCount = getAfter(groupPath()).data.get('memberCount', null);
        return afterCount is int &&
          ((beforeCount is int && beforeCount > 0 && afterCount == beforeCount - 1) ||
           (!(beforeCount is int) && afterCount >= 0)) &&
          exists(memberPath(memberUid)) &&
          !existsAfter(memberPath(memberUid));
      }

      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'name', 'description', 'ownerId', 'visibility', 'memberCount', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.description is string && request.resource.data.description.size() <= 300 &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.visibility in ['public', 'private'] &&
        request.resource.data.memberCount == 1 &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'updatedAt', 'avatarPath', 'isDeleting'
          ]) &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 60 &&
          request.resource.data.description is string && request.resource.data.description.size() <= 300 &&
          (!('isDeleting' in request.resource.data) || request.resource.data.isDeleting is bool) &&
          (resource.data.get('isDeleting', false) != true ||
            (request.resource.data.isDeleting == true &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleting', 'updatedAt']))) &&
          (!('avatarPath' in request.resource.data) ||
           request.resource.data.avatarPath.matches(
             'group_images/' + groupId + '/' + request.auth.uid + '/[^/]+'
           )) &&
          request.resource.data.updatedAt == request.time) ||
        validPublicJoinCountUpdate() ||
        validMemberLeaveCountUpdate() ||
        validManagerCountUpdate() ||
        (resource.data.ownerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
          request.resource.data.memberCount is int && request.resource.data.memberCount >= 0)
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{memberUid} {
        function privateGroup() {
          return exists(groupPath()) &&
            get(groupPath()).data.visibility == 'private';
        }
        allow read: if signedIn() &&
          (memberUid == request.auth.uid || publicGroup() || isGroupMember() ||
           isGroupManager());
        allow create: if signedIn() &&
          getAfter(groupPath()).data.get('isDeleting', false) != true &&
          request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt']) &&
          request.resource.data.uid == memberUid &&
          request.resource.data.displayName is string && request.resource.data.createdAt == request.time &&
          ((request.auth.uid == memberUid &&
            getAfter(groupPath()).data.ownerId == request.auth.uid &&
            getAfter(groupPath()).data.memberCount == 1) ||
           (request.auth.uid == memberUid && publicGroup() &&
            validIncrementForMember(memberUid)) ||
           (isGroupManager() && privateGroup() &&
            exists(requestPath(memberUid)) &&
            get(requestPath(memberUid)).data.uid == memberUid &&
            !existsAfter(requestPath(memberUid)) &&
            validIncrementForMember(memberUid)));
        allow delete: if signedIn() &&
          (request.auth.uid == resource.data.uid &&
             validDecrementForMember(memberUid) ||
           isGroupManager());
        allow update: if false;
      }

      match /join_requests/{requesterUid} {
        allow read: if signedIn() &&
          (request.auth.uid == requesterUid || isGroupManager());
        allow create: if signedIn() && request.auth.uid == requesterUid &&
          get(groupPath()).data.get('isDeleting', false) != true &&
          get(groupPath()).data.visibility == 'private' &&
          !exists(memberPath(requesterUid)) &&
          request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt']) &&
          request.resource.data.uid == requesterUid &&
          request.resource.data.displayName is string &&
          request.resource.data.createdAt == request.time;
        allow delete: if signedIn() &&
          (request.auth.uid == requesterUid || isGroupManager());
        allow update: if false;
      }

      match /posts/{groupPostId} {
        function postPath() {
          return /databases/$(database)/documents/groups/$(groupId)/posts/$(groupPostId);
        }
        // ใช้ schema เดียวกันทั้งสร้างและแก้ไข โดยคงเจ้าของ เวลาเดิม และ path สื่อของโพสต์
        function validGroupPost(data) {
          return data.authorName is string && data.content is string && data.content.size() <= 1000 &&
            (!('groupVisibility' in data) || data.groupVisibility == get(groupPath()).data.visibility) &&
            (!('tags' in data) || validPostTags(data.tags)) &&
            (data.content.size() > 0 || data.mediaType != 'none' || data.get('sharedPostId', null) is string) &&
            data.mediaType in ['none', 'image', 'video'] &&
            ((data.mediaType == 'none' && !('mediaPath' in data) && !('thumbnailPath' in data)) ||
             (data.mediaType in ['image', 'video'] && data.mediaPath is string &&
              data.mediaPath.matches('group_media/' + groupId + '/' + groupPostId + '/' + data.authorId + '/[^/]+') &&
              (!('thumbnailPath' in data) ||
               (data.mediaType == 'video' && data.thumbnailPath is string &&
                data.thumbnailPath.matches('group_media/' + groupId + '/' + groupPostId + '/' + data.authorId + '/[^/]+')))));
        }
        allow read: if canReadGroupContent();
        allow create: if canPostInGroup(groupId) && validWriteTicket('groups/' + groupId + '/posts/' + groupPostId, groupPostId) && isGroupMember() &&
          get(groupPath()).data.get('isDeleting', false) != true &&
          request.resource.data.keys().hasAll([
            'authorId', 'authorName', 'content', 'createdAt', 'mediaType'
          ]) &&
          request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'content', 'createdAt', 'mediaType',
            'mediaPath', 'thumbnailPath', 'tags', 'taggedUserIds', 'groupVisibility'
          ]) &&
          request.resource.data.authorId == request.auth.uid &&
          validGroupPost(request.resource.data) &&
          validTaggedUserIds(request.resource.data) && validTagTicket('groups/' + groupId + '/posts/' + groupPostId, groupPostId, request.resource.data) &&
          request.resource.data.authorName is string &&
          request.resource.data.content is string &&
          request.resource.data.content.size() <= 1000 &&
          (request.resource.data.content.size() > 0 || request.resource.data.mediaType != 'none') &&
          request.resource.data.mediaType in ['none', 'image', 'video'] &&
          request.resource.data.createdAt == request.time &&
          ((request.resource.data.mediaType == 'none' &&
            !('mediaPath' in request.resource.data) &&
            !('thumbnailPath' in request.resource.data)) ||
           (request.resource.data.mediaType == 'image' &&
            request.resource.data.mediaPath is string &&
            request.resource.data.mediaPath.matches(
              'group_media/' + groupId + '/' + groupPostId + '/' + request.auth.uid + '/[^/]+'
            ) && !('thumbnailPath' in request.resource.data)) ||
           (request.resource.data.mediaType == 'video' &&
            request.resource.data.mediaPath is string &&
            request.resource.data.mediaPath.matches(
              'group_media/' + groupId + '/' + groupPostId + '/' + request.auth.uid + '/[^/]+'
            ) &&
            (!('thumbnailPath' in request.resource.data) ||
             request.resource.data.thumbnailPath.matches(
               'group_media/' + groupId + '/' + groupPostId + '/' + request.auth.uid + '/[^/]+'
             ))));
        allow update: if isGroupMember() && resource.data.authorId == request.auth.uid &&
          get(groupPath()).data.get('isDeleting', false) != true &&
          resource.data.get('isDeleting', false) != true &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'content', 'tags', 'mediaPath', 'mediaType', 'thumbnailPath', 'updatedAt', 'editedAt', 'taggedUserIds', 'groupVisibility'
          ]) && validGroupPost(request.resource.data) &&
          validTaggedUserIds(request.resource.data) &&
          (request.resource.data.get('taggedUserIds', []) == resource.data.get('taggedUserIds', []) ||
           validTagTicket('groups/' + groupId + '/posts/' + groupPostId, groupPostId, request.resource.data)) &&
          request.resource.data.updatedAt == request.time && request.resource.data.editedAt == request.time;
        // ปิดการเพิ่มข้อมูลย่อยก่อนเริ่มลบ เพื่อให้การลบหลาย batch ทำต่อได้อย่างปลอดภัย
        allow update: if (isGroupMember() || isGroupManager()) &&
          (resource.data.authorId == request.auth.uid || isGroupManager()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleting', 'updatedAt']) &&
          request.resource.data.isDeleting == true && request.resource.data.updatedAt == request.time;
        allow delete: if (isGroupMember() || isGroupManager()) &&
          (resource.data.authorId == request.auth.uid || isGroupManager());

        // อ่านตามสิทธิ์กลุ่ม แต่ต้องเป็นสมาชิกจึงเพิ่มความคิดเห็นหรือปฏิกิริยาได้
        match /comments/{commentId} {
          allow read: if canReadGroupContent();
          allow create: if verifiedMember() && notBlocked(get(postPath()).data.authorId) && isGroupMember() && exists(postPath()) &&
            get(groupPath()).data.get('isDeleting', false) != true &&
            get(postPath()).data.get('isDeleting', false) != true &&
            request.resource.data.keys().hasAll(['authorId', 'authorName', 'content', 'createdAt']) &&
            request.resource.data.keys().hasOnly(['authorId', 'authorName', 'content', 'createdAt']) &&
            request.resource.data.authorId == request.auth.uid && request.resource.data.authorName is string &&
            request.resource.data.content is string && request.resource.data.content.size() > 0 &&
            request.resource.data.content.size() <= 1000 && request.resource.data.createdAt == request.time;
          allow delete: if (isGroupMember() || isGroupManager()) &&
            (resource.data.authorId == request.auth.uid || isGroupManager() || get(postPath()).data.authorId == request.auth.uid);
          allow update: if false;
        }

        match /reactions/{reactorUid} {
          allow read: if canReadGroupContent();
          allow create, update: if verifiedMember() && notBlocked(get(postPath()).data.authorId) && isGroupMember() && request.auth.uid == reactorUid &&
            get(groupPath()).data.get('isDeleting', false) != true &&
            exists(postPath()) && get(postPath()).data.get('isDeleting', false) != true &&
            request.resource.data.keys().hasOnly(['uid', 'reaction', 'updatedAt']) &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.reaction in [
              'like', 'love', 'haha', 'wow', 'sad', 'angry', 'dislike'
            ] &&
            request.resource.data.updatedAt == request.time;
          allow delete: if (isGroupMember() || isGroupManager()) &&
            (request.auth.uid == reactorUid || isGroupManager() || get(postPath()).data.authorId == request.auth.uid);
        }
      }
    }

  }
}
