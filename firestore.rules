// กฎ Firestore ของแอป: ทุก collection เปิดสิทธิ์เฉพาะกรณีที่ประกาศไว้ใน match
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ใช้ helper นี้เพื่อลดการเขียนเงื่อนไขตรวจบัญชีซ้ำในแต่ละ collection
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    function isApprovedFollower(userId) {
      return signedIn() && exists(
        /databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)
      );
    }

    function canReadPostData(postData) {
      let visibility = postData.get('visibility', 'public');
      return signedIn() && (
        isAdmin() || postData.userId == request.auth.uid ||
        visibility == 'public' ||
        (visibility == 'followers' && isApprovedFollower(postData.userId))
      );
    }

    function validPostVisibility(postData) {
      let ownerPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let privateProfile = getAfter(ownerPath).data.get('isPrivate', false) == true;
      return postData.visibility in ['public', 'private', 'followers'] &&
        postData.get('authorIsPrivate', false) == privateProfile &&
        ((privateProfile && postData.visibility in ['private', 'followers']) ||
         (!privateProfile && postData.visibility in ['private', 'public']));
    }

    function validPostUpdateTimestamps() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['visibility', 'authorIsPrivate']) ||
        (changed.hasAll(['updatedAt', 'editedAt']) &&
         request.resource.data.updatedAt == request.time &&
         request.resource.data.editedAt == request.time) ||
        (changed.hasOnly([
           'tags', 'visibility', 'mediaType', 'updatedAt', 'thumbnailPath',
           'authorIsPrivate'
         ]) &&
         request.resource.data.updatedAt == request.time &&
         request.resource.data.get('editedAt', null) == resource.data.get('editedAt', null));
    }

    // Admin ต้องได้รับ custom claim admin จากระบบที่เชื่อถือได้เท่านั้น

    // Ensure an optional video thumbnail stays inside the owning post folder.
    function hasValidPostThumbnail(data, postId) {
      return (data.mediaType == 'video' &&
          (!('thumbnailPath' in data) ||
           (data.thumbnailPath is string &&
            data.thumbnailPath.matches(
              'post_media/' + request.auth.uid + '/' + postId + '/[^/]+'
            )))) ||
        (data.mediaType != 'video' && !('thumbnailPath' in data));
    }

    // เอกสารโปรไฟล์อ่านได้เมื่อเข้าสู่ระบบ แต่แก้ได้เฉพาะเจ้าของ UID
    match /users/{userId} {
      allow read: if signedIn();
      allow create, delete: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'displayNameLower', 'isPrivate', 'avatarPath', 'bio'
        ]) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.displayName.size() <= 60 &&
        request.resource.data.displayNameLower is string &&
        request.resource.data.isPrivate is bool &&
        (!('avatarPath' in request.resource.data) ||
         request.resource.data.avatarPath.matches(
           'profile_images/' + request.auth.uid + '/[^/]+'
         )) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['bio']) ||
         (request.resource.data.bio is string &&
          request.resource.data.bio.size() <= 160));

      // สมาชิกอ่านความสัมพันธ์ได้ แต่สร้าง/ลบได้เฉพาะความสัมพันธ์ของตนเอง
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          followerUid != userId &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
          request.resource.data.uid == followerUid &&
          request.resource.data.createdAt == request.time &&
          ((request.auth.uid == followerUid &&
            get(/databases/$(database)/documents/users/$(userId)).data.get('isPrivate', false) != true) ||
           (request.auth.uid == userId &&
            exists(/databases/$(database)/documents/users/$(userId)/follow_requests/$(followerUid))));
        allow delete: if signedIn() &&
          (request.auth.uid == followerUid || request.auth.uid == userId);
        allow update: if false;
      }

      match /following/{followedUid} {
        allow read: if signedIn();
        allow create: if signedIn() &&
          followedUid != userId &&
          exists(/databases/$(database)/documents/users/$(followedUid)) &&
          request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
          request.resource.data.uid == followedUid &&
          request.resource.data.createdAt == request.time &&
          ((request.auth.uid == userId &&
            get(/databases/$(database)/documents/users/$(followedUid)).data.get('isPrivate', false) != true) ||
           (request.auth.uid == followedUid &&
            exists(/databases/$(database)/documents/users/$(followedUid)/follow_requests/$(userId))));
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }

      match /follow_requests/{requesterUid} {
        allow read: if signedIn() && (request.auth.uid == userId || request.auth.uid == requesterUid);
        allow create: if signedIn() && request.auth.uid == requesterUid &&
          requesterUid != userId &&
          get(/databases/$(database)/documents/users/$(userId)).data.get('isPrivate', false) == true &&
          !exists(/databases/$(database)/documents/users/$(userId)/followers/$(requesterUid)) &&
          request.resource.data.keys().hasOnly(['uid', 'createdAt']) &&
          request.resource.data.uid == requesterUid &&
          request.resource.data.createdAt == request.time;
        allow delete: if signedIn() &&
          (request.auth.uid == requesterUid || request.auth.uid == userId);
        allow update: if false;
      }
    }

    match /posts/{postId} {
      // โพสต์สาธารณะอ่านได้โดยสมาชิก; โพสต์ส่วนตัวอ่านได้เฉพาะเจ้าของ
      // Single-document reads can use the full policy, including legacy docs.
      allow get: if canReadPostData(resource.data);

      // Keep each list permission aligned with its matching query constraint.
      // Firestore evaluates a query as a whole and cannot filter out documents
      // that do not satisfy the read rules.
      allow list: if signedIn() && isAdmin();
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow list: if signedIn() && resource.data.visibility == 'public';
      allow list: if signedIn() && resource.data.visibility == 'followers' &&
        isApprovedFollower(resource.data.userId);

      allow create: if signedIn() &&
        request.resource.data.keys().hasAll([
          'userId', 'authorName', 'content', 'tags', 'visibility',
          'createdAt', 'updatedAt', 'mediaType'
        ]) &&
        request.resource.data.keys().hasOnly([
          'userId', 'authorName', 'content', 'tags', 'visibility',
          'createdAt', 'updatedAt', 'mediaPath', 'mediaType', 'thumbnailPath',
          'authorIsPrivate'
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.authorName is string &&
        request.resource.data.authorIsPrivate is bool &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 1000 &&
        request.resource.data.tags is list &&
        request.resource.data.tags.size() <= 5 &&
        validPostVisibility(request.resource.data) &&
        request.resource.data.mediaType in ['none', 'image', 'video'] &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        ((request.resource.data.mediaType == 'none' &&
          !('mediaPath' in request.resource.data)) ||
         (request.resource.data.mediaType in ['image', 'video'] &&
          request.resource.data.mediaPath is string &&
          request.resource.data.mediaPath.matches(
            'post_media/' + request.auth.uid + '/' + postId + '/[^/]+'
          ))) &&
        hasValidPostThumbnail(request.resource.data, postId);

      // เจ้าของเปลี่ยนได้เฉพาะข้อมูลของโพสต์ ห้ามย้าย ownership
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'content', 'tags', 'visibility', 'updatedAt', 'editedAt',
          'mediaPath', 'mediaType', 'thumbnailPath', 'authorIsPrivate'
        ]) &&
        validPostUpdateTimestamps() &&
        request.resource.data.content is string &&
        request.resource.data.content.size() <= 1000 &&
        request.resource.data.tags is list &&
        request.resource.data.tags.size() <= 5 &&
        request.resource.data.authorIsPrivate is bool &&
        validPostVisibility(request.resource.data) &&
        request.resource.data.mediaType in ['none', 'image', 'video'] &&
        ((request.resource.data.mediaType == 'none' &&
          !('mediaPath' in request.resource.data)) ||
         (request.resource.data.mediaType in ['image', 'video'] &&
          request.resource.data.mediaPath is string &&
          request.resource.data.mediaPath.matches(
            'post_media/' + request.auth.uid + '/' + postId + '/[^/]+'
          ))) &&
        hasValidPostThumbnail(request.resource.data, postId);

      allow delete: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // ความคิดเห็นสืบทอดสิทธิ์อ่านจากโพสต์; เพิ่มได้เฉพาะสมาชิกที่อ่านโพสต์ได้
      match /comments/{commentId} {
        function canReadPost() {
          return canReadPostData(get(/databases/$(database)/documents/posts/$(postId)).data);
        }

        allow read: if canReadPost();
        allow create: if canReadPost() &&
          request.resource.data.keys().hasAll(['authorId', 'authorName', 'content', 'createdAt']) &&
          request.resource.data.keys().hasOnly(['authorId', 'authorName', 'content', 'createdAt']) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.authorName is string &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 1000 &&
          request.resource.data.createdAt == request.time;
        allow delete: if signedIn() &&
          (resource.data.authorId == request.auth.uid || isAdmin());
        allow update: if false;
      }

      // แต่ละบัญชีมี reaction ได้หนึ่งรายการต่อโพสต์ และจัดการได้เฉพาะของตัวเอง
      match /reactions/{reactorUid} {
        function canReadPost() {
          return canReadPostData(get(/databases/$(database)/documents/posts/$(postId)).data);
        }
        allow read: if canReadPost();
        allow create, update: if canReadPost() && request.auth.uid == reactorUid &&
          request.resource.data.keys().hasOnly(['uid', 'reaction', 'updatedAt']) &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.reaction in ['like', 'dislike'] &&
          request.resource.data.updatedAt == request.time;
        allow delete: if canReadPost() &&
          (request.auth.uid == reactorUid || isAdmin());
      }
    }

    match /post_reports/{reportId} {
      // รายงานเป็นข้อมูลส่วนตัว ผู้ใช้ส่งได้ แต่มีเพียงแอดมินที่เปิดดู/ปรับสถานะได้
      allow create: if signedIn() &&
        request.resource.data.keys().hasAll([
          'postId', 'postOwnerId', 'reporterUid', 'reason',
          'details', 'status', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'postId', 'postOwnerId', 'reporterUid', 'reason',
          'details', 'status', 'createdAt'
        ]) &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.postId is string &&
        request.resource.data.postOwnerId is string &&
        request.resource.data.postOwnerId != request.auth.uid &&
        request.resource.data.status == 'open' &&
        request.resource.data.reason is string &&
        request.resource.data.details is string &&
        request.resource.data.details.size() <= 300 &&
        request.resource.data.createdAt == request.time &&
        reportId == request.resource.data.postId + '_' + request.auth.uid &&
        exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)) &&
        get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.userId == request.resource.data.postOwnerId &&
        canReadPostData(get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data) &&
        !exists(/databases/$(database)/documents/post_reports/$(reportId));

      allow read: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'reviewedAt', 'reviewedBy'
        ]) &&
        request.resource.data.status in ['resolved', 'dismissed', 'removed'] &&
        request.resource.data.reviewedBy == request.auth.uid &&
        request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    match /conversations/{conversationId} {
      // ใช้ participantIds กลางเพื่อตรวจสมาชิกก่อนเปิดห้องหรือเปลี่ยนสถานะอ่าน
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participantIds;
      }
      function otherParticipantUid() {
        let participantIds = resource.data.participantIds;
        return participantIds[0] == request.auth.uid
          ? participantIds[1]
          : participantIds[0];
      }
      // ซ่อน/เปิดห้องได้เฉพาะสถานะของตนเอง และต้องเก็บสถานะของคู่สนทนาไว้
      function canChangeOwnHiddenState() {
        let participantIds = resource.data.participantIds;
        let oldHidden = resource.data.get('hiddenFor', {});
        let newHidden = request.resource.data.get('hiddenFor', {});
        return newHidden is map &&
          newHidden.keys().hasOnly(participantIds) &&
          newHidden.get(request.auth.uid, false) is bool &&
          newHidden.get(otherParticipantUid(), false) ==
            oldHidden.get(otherParticipantUid(), false);
      }
      // ล้าง unread และบันทึกเวลาอ่านของตนเอง โดยห้ามแก้สถานะอ่านของอีกฝ่าย
      function canUpdateOwnReadState() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let oldUnread = resource.data.get('unreadCounts', {});
        let newUnread = request.resource.data.get('unreadCounts', {});
        let oldRead = resource.data.get('lastReadAt', {});
        let newRead = request.resource.data.get('lastReadAt', {});
        return changed.hasAny(['unreadCounts', 'lastReadAt']) &&
          changed.hasOnly(['unreadCounts', 'lastReadAt', 'updatedAt']) &&
          newUnread is map && newUnread.keys().hasOnly(resource.data.participantIds) &&
          newUnread.get(request.auth.uid, 0) == 0 &&
          newUnread.get(otherParticipantUid(), 0) ==
            oldUnread.get(otherParticipantUid(), 0) &&
          newRead is map && newRead.keys().hasOnly(resource.data.participantIds) &&
          newRead.get(request.auth.uid, null) == request.time &&
          newRead.get(otherParticipantUid(), null) ==
            oldRead.get(otherParticipantUid(), null) &&
          request.resource.data.updatedAt == request.time;
      }
      // ตรวจสรุปห้องเทียบกับข้อความใหม่หลัง batch ผ่าน getAfter()
      // เพื่อให้ข้อความ ตัวอย่างล่าสุด และตัวนับ unread ถูกบันทึกด้วยกันอย่างถูกต้อง
      function canUpdateForNewMessage() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let oldUnread = resource.data.get('unreadCounts', {});
        let newUnread = request.resource.data.get('unreadCounts', {});
        let oldRead = resource.data.get('lastReadAt', {});
        let newRead = request.resource.data.get('lastReadAt', {});
        let messageId = request.resource.data.get('lastMessageId', '');
        let safeMessageId = messageId is string && messageId.matches('[^/]+') ? messageId : '__invalid_message_id__';
        let messagePath = /databases/$(database)/documents/conversations/$(conversationId)/messages/$(safeMessageId);
        // affectedKeys() นับเฉพาะ field ที่ค่าเปลี่ยนจริง ไม่ใช่ทุก field ที่ส่งมา
        // ข้อความ ชนิด และผู้ส่งซ้ำค่าเดิมได้ จึงไม่บังคับสาม field นี้ใน hasAll()
        // แต่ยังบังคับ ID/สถานะกิจกรรมใหม่ และตรวจค่าตัวอย่างกับข้อความจริงด้านล่าง
        return changed.hasAll([
            'lastMessageAt', 'lastMessageId', 'unreadCounts', 'lastReadAt',
            'updatedAt'
          ]) &&
          changed.hasOnly([
            'lastMessageText', 'lastMessageType', 'lastMessageSenderId',
            'lastMessageAt', 'lastMessageId', 'unreadCounts', 'lastReadAt',
            'hiddenFor', 'updatedAt'
          ]) &&
          request.resource.data.lastMessageId is string &&
          existsAfter(messagePath) &&
          getAfter(messagePath).data.senderId == request.auth.uid &&
          getAfter(messagePath).data.createdAt == request.time &&
          getAfter(messagePath).data.type == request.resource.data.lastMessageType &&
          getAfter(messagePath).data.type in ['text', 'image', 'video'] &&
          getAfter(messagePath).data.text is string &&
          getAfter(messagePath).data.text.size() <= 2000 &&
          request.resource.data.lastMessageText is string &&
          request.resource.data.lastMessageText.size() <= 2000 &&
          request.resource.data.lastMessageText ==
            (getAfter(messagePath).data.text.size() > 0
              ? getAfter(messagePath).data.text
              : getAfter(messagePath).data.type == 'image'
                ? 'ส่งรูปภาพให้คุณ'
                : getAfter(messagePath).data.type == 'video'
                  ? 'ส่งวิดีโอให้คุณ'
                  : '') &&
          request.resource.data.lastMessageSenderId == request.auth.uid &&
          request.resource.data.lastMessageAt == request.time &&
          newUnread is map && newUnread.keys().hasOnly(resource.data.participantIds) &&
          newUnread.get(request.auth.uid, 0) == 0 &&
          newUnread.get(otherParticipantUid(), 0) ==
            oldUnread.get(otherParticipantUid(), 0) + 1 &&
          newRead is map && newRead.keys().hasOnly(resource.data.participantIds) &&
          newRead.get(request.auth.uid, null) == request.time &&
          newRead.get(otherParticipantUid(), null) ==
            oldRead.get(otherParticipantUid(), null) &&
          (!changed.hasAny(['hiddenFor']) || canChangeOwnHiddenState()) &&
          request.resource.data.updatedAt == request.time;
      }
      // อนุญาตให้เจ้าของยกเลิกข้อความล่าสุด และต้องตรงกับข้อความที่เปลี่ยนเป็น deleted
      // ไม่บังคับ preview เปลี่ยนค่า เพราะข้อความเดิมอาจเป็นคำว่า "ยกเลิกข้อความนี้" อยู่แล้ว
      function canUpdateForUnsentLatestMessage() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let messageId = resource.data.get('lastMessageId', '');
        let safeMessageId = messageId is string && messageId.matches('[^/]+') ? messageId : '__invalid_message_id__';
        let messagePath = /databases/$(database)/documents/conversations/$(conversationId)/messages/$(safeMessageId);
        return changed.hasAll(['lastMessageType', 'updatedAt']) &&
          changed.hasOnly(['lastMessageText', 'lastMessageType', 'updatedAt']) &&
          request.resource.data.lastMessageId == resource.data.lastMessageId &&
          existsAfter(messagePath) &&
          getAfter(messagePath).data.senderId == request.auth.uid &&
          getAfter(messagePath).data.type == 'deleted' &&
          getAfter(messagePath).data.text == 'ยกเลิกข้อความนี้' &&
          getAfter(messagePath).data.deletedAt == request.time &&
          request.resource.data.lastMessageType == 'deleted' &&
          request.resource.data.lastMessageText == 'ยกเลิกข้อความนี้' &&
          request.resource.data.updatedAt == request.time;
      }
      function canUpdateOwnHiddenStateOnly() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        // เปิดห้องที่มองเห็นอยู่แล้วอาจเขียน hiddenFor=false ซ้ำ จึงไม่บังคับว่าค่าต้องเปลี่ยน
        return changed.hasOnly(['hiddenFor', 'updatedAt']) &&
          canChangeOwnHiddenState() &&
          request.resource.data.updatedAt == request.time;
      }
      // Transactions that create a deterministic conversation first read its
      // document. Allow signed-in users to read a missing ID so they can create
      // it; existing conversations remain visible to participants only.
      allow get: if signedIn() &&
        (!exists(/databases/$(database)/documents/conversations/$(conversationId)) ||
         isParticipant());
      allow list: if isParticipant();
      allow create: if signedIn() &&
        request.resource.data.keys().hasAll(['participantIds','participantNames','unreadCounts','lastReadAt','createdAt','updatedAt']) &&
        request.resource.data.keys().hasOnly(['participantIds','participantNames','unreadCounts','lastReadAt','createdAt','updatedAt']) &&
        request.resource.data.participantIds is list &&
        request.resource.data.participantIds.size() == 2 &&
        request.resource.data.participantIds[0] is string &&
        request.resource.data.participantIds[1] is string &&
        request.resource.data.participantIds[0] != request.resource.data.participantIds[1] &&
        request.resource.data.participantIds.hasAny([request.auth.uid]) &&
        request.resource.data.participantNames is map &&
        request.resource.data.unreadCounts is map &&
        request.resource.data.lastReadAt is map &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[0])) &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.participantIds[1])) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isParticipant() &&
        request.resource.data.participantIds == resource.data.participantIds &&
        (canUpdateOwnReadState() ||
         canUpdateForNewMessage() ||
         canUpdateForUnsentLatestMessage() ||
         canUpdateOwnHiddenStateOnly());
      allow delete: if false;

      match /messages/{messageId} {
        // ข้อความอ่านได้เฉพาะสมาชิก; สร้างได้โดยผู้ส่งที่ล็อกอินและอยู่ในห้อง
        function parentHasParticipant() {
          return signedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        }
        allow read: if parentHasParticipant();
        allow create: if parentHasParticipant() &&
          request.resource.data.keys().hasAll(['senderId','type','text','createdAt']) &&
          request.resource.data.keys().hasOnly(['senderId','type','text','mediaPath','createdAt']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.type in ['text','image','video'] &&
          request.resource.data.text is string && request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time &&
          ((request.resource.data.type == 'text' && !('mediaPath' in request.resource.data)) ||
           (request.resource.data.type in ['image','video'] &&
            request.resource.data.mediaPath is string &&
            request.resource.data.mediaPath.matches('chat_media/' + conversationId + '/' + request.auth.uid + '/[^/]+')));
        allow update: if parentHasParticipant() &&
          resource.data.senderId == request.auth.uid &&
          resource.data.type in ['text','image','video'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'type','text','mediaPath','deletedAt'
          ]) &&
          request.resource.data.type == 'deleted' &&
          request.resource.data.text == 'ยกเลิกข้อความนี้' &&
          !('mediaPath' in request.resource.data) &&
          request.resource.data.deletedAt == request.time;
        allow delete: if false;
      }
    }

    // แจ้งเตือนส่วนนี้ใช้กับกิจกรรมทางสังคม; ข้อความแชทนับ unread ใน conversation
    match /notifications/{notificationId} {
      function validNotificationBase() {
        return request.resource.data.keys().hasAll([
            'recipientId', 'actorId', 'actorName', 'type', 'body',
            'isRead', 'createdAt'
          ]) &&
          request.resource.data.keys().hasOnly([
            'recipientId', 'actorId', 'actorName', 'type', 'body',
            'postId', 'commentId', 'isRead', 'createdAt'
          ]) &&
          request.resource.data.recipientId is string &&
          request.resource.data.recipientId.matches('[^/]+') &&
          request.resource.data.recipientId != request.auth.uid &&
          request.resource.data.actorId == request.auth.uid &&
          request.resource.data.actorName is string &&
          request.resource.data.type in ['comment', 'like', 'follow'] &&
          request.resource.data.isRead == false &&
          request.resource.data.body is string &&
          request.resource.data.body.size() <= 2000 &&
          request.resource.data.createdAt == request.time;
      }
      function validCommentNotification() {
        return request.resource.data.type == 'comment' &&
          request.resource.data.postId is string &&
          request.resource.data.postId.matches('[^/]+') &&
          request.resource.data.commentId is string &&
          request.resource.data.commentId.matches('[^/]+') &&
          validCommentNotificationDetails(
            request.resource.data.postId,
            request.resource.data.commentId
          );
      }
      function validCommentNotificationDetails(postId, commentId) {
        let postPath = /databases/$(database)/documents/posts/$(postId);
        let commentPath = /databases/$(database)/documents/posts/$(postId)/comments/$(commentId);
        let post = get(postPath).data;
        let comment = get(commentPath).data;
        return exists(postPath) && exists(commentPath) &&
          post.userId is string &&
          canReadPostData(post) &&
          exists(/databases/$(database)/documents/users/$(post.userId)/followers/$(request.resource.data.recipientId)) &&
          notificationId == 'comment_' + request.resource.data.commentId + '_' + request.resource.data.recipientId &&
          comment.authorId == request.auth.uid &&
          comment.authorName == request.resource.data.actorName &&
          comment.content == request.resource.data.body;
      }
      function validLikeNotification() {
        return request.resource.data.type == 'like' &&
          request.resource.data.postId is string &&
          request.resource.data.postId.matches('[^/]+') &&
          !('commentId' in request.resource.data) &&
          validLikeNotificationDetails(request.resource.data.postId);
      }
      function validLikeNotificationDetails(postId) {
        let postPath = /databases/$(database)/documents/posts/$(postId);
        let reactionPath = /databases/$(database)/documents/posts/$(postId)/reactions/$(request.auth.uid);
        let post = get(postPath).data;
        let reaction = getAfter(reactionPath).data;
        return exists(postPath) && post.userId == request.resource.data.recipientId &&
          existsAfter(reactionPath) && reaction.uid == request.auth.uid &&
          reaction.reaction == 'like' && reaction.updatedAt == request.time;
      }
      function validFollowNotification() {
        let directFollowerPath = /databases/$(database)/documents/users/$(request.resource.data.recipientId)/followers/$(request.auth.uid);
        let directFollowingPath = /databases/$(database)/documents/users/$(request.auth.uid)/following/$(request.resource.data.recipientId);
        let acceptedFollowerPath = /databases/$(database)/documents/users/$(request.auth.uid)/followers/$(request.resource.data.recipientId);
        let acceptedFollowingPath = /databases/$(database)/documents/users/$(request.resource.data.recipientId)/following/$(request.auth.uid);
        let directFollower = getAfter(directFollowerPath).data;
        let directFollowing = getAfter(directFollowingPath).data;
        let acceptedFollower = getAfter(acceptedFollowerPath).data;
        let acceptedFollowing = getAfter(acceptedFollowingPath).data;
        return request.resource.data.type == 'follow' &&
          !('postId' in request.resource.data) &&
          !('commentId' in request.resource.data) &&
          ((existsAfter(directFollowerPath) && existsAfter(directFollowingPath) &&
            directFollower.uid == request.auth.uid &&
            directFollowing.uid == request.resource.data.recipientId) ||
           (existsAfter(acceptedFollowerPath) && existsAfter(acceptedFollowingPath) &&
            acceptedFollower.uid == request.resource.data.recipientId &&
            acceptedFollowing.uid == request.auth.uid));
      }
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if signedIn() && validNotificationBase() &&
        (validCommentNotification() ||
         validLikeNotification() ||
         validFollowNotification());
      allow update: if signedIn() && resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']) && request.resource.data.isRead == true;
      allow delete: if false;
    }

    // Group metadata can be discovered after sign-in. Private posts and members
    // remain restricted to accepted members and the group owner.
    match /groups/{groupId} {
      function groupPath() {
        return /databases/$(database)/documents/groups/$(groupId);
      }
      function memberPath(memberUid) {
        return /databases/$(database)/documents/groups/$(groupId)/members/$(memberUid);
      }
      function requestPath(requesterUid) {
        return /databases/$(database)/documents/groups/$(groupId)/join_requests/$(requesterUid);
      }
      function isGroupOwner() {
        return signedIn() && exists(groupPath()) &&
          get(groupPath()).data.ownerId == request.auth.uid;
      }
      function isGroupManager() {
        return isGroupOwner() || isAdmin();
      }
      function isGroupMember() {
        return signedIn() &&
          exists(memberPath(request.auth.uid));
      }
      function publicGroup() {
        return exists(groupPath()) &&
          get(groupPath()).data.visibility == 'public';
      }
      function validCountIncrement() {
        let beforeCount = resource.data.get('memberCount', null);
        let afterCount = request.resource.data.get('memberCount', null);
        return afterCount is int &&
          ((beforeCount is int && afterCount == beforeCount + 1) ||
           (!(beforeCount is int) && afterCount > 0));
      }
      function validCountDecrement() {
        let beforeCount = resource.data.get('memberCount', null);
        let afterCount = request.resource.data.get('memberCount', null);
        return afterCount is int &&
          ((beforeCount is int && beforeCount > 0 && afterCount == beforeCount - 1) ||
           (!(beforeCount is int) && afterCount >= 0));
      }
      function validPublicJoinCountUpdate() {
        return signedIn() && publicGroup() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
          validCountIncrement() &&
          !exists(memberPath(request.auth.uid)) &&
          existsAfter(memberPath(request.auth.uid)) &&
          getAfter(memberPath(request.auth.uid)).data.uid == request.auth.uid;
      }
      function validMemberLeaveCountUpdate() {
        return signedIn() && request.auth.uid != resource.data.ownerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
          validCountDecrement() &&
          exists(memberPath(request.auth.uid)) &&
          !existsAfter(memberPath(request.auth.uid));
      }
      function validManagerCountUpdate() {
        return signedIn() && isGroupManager() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
          validCountIncrement();
      }
      function validIncrementForMember(memberUid) {
        let beforeCount = get(groupPath()).data.get('memberCount', null);
        let afterCount = getAfter(groupPath()).data.get('memberCount', null);
        return afterCount is int &&
          ((beforeCount is int && afterCount == beforeCount + 1) ||
           (!(beforeCount is int) && afterCount > 0)) &&
          !exists(memberPath(memberUid)) &&
          existsAfter(memberPath(memberUid)) &&
          getAfter(memberPath(memberUid)).data.uid == memberUid;
      }
      function validDecrementForMember(memberUid) {
        let beforeCount = get(groupPath()).data.get('memberCount', null);
        let afterCount = getAfter(groupPath()).data.get('memberCount', null);
        return afterCount is int &&
          ((beforeCount is int && beforeCount > 0 && afterCount == beforeCount - 1) ||
           (!(beforeCount is int) && afterCount >= 0)) &&
          exists(memberPath(memberUid)) &&
          !existsAfter(memberPath(memberUid));
      }

      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly([
          'name', 'description', 'ownerId', 'visibility', 'memberCount', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.description is string && request.resource.data.description.size() <= 300 &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.visibility in ['public', 'private'] &&
        request.resource.data.memberCount == 1 &&
        request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'description', 'updatedAt', 'avatarPath'
          ]) &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
          request.resource.data.name.size() <= 60 &&
          request.resource.data.description is string && request.resource.data.description.size() <= 300 &&
          (!('avatarPath' in request.resource.data) ||
           request.resource.data.avatarPath.matches(
             'group_images/' + groupId + '/' + request.auth.uid + '/[^/]+'
           )) &&
          request.resource.data.updatedAt == request.time) ||
        validPublicJoinCountUpdate() ||
        validMemberLeaveCountUpdate() ||
        validManagerCountUpdate() ||
        (resource.data.ownerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']) &&
          request.resource.data.memberCount is int && request.resource.data.memberCount >= 0)
      );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{memberUid} {
        function privateGroup() {
          return exists(groupPath()) &&
            get(groupPath()).data.visibility == 'private';
        }
        allow read: if signedIn() &&
          (memberUid == request.auth.uid || publicGroup() || isGroupMember() ||
           isGroupOwner());
        allow create: if signedIn() &&
          request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt']) &&
          request.resource.data.uid == memberUid &&
          request.resource.data.displayName is string && request.resource.data.createdAt == request.time &&
          ((request.auth.uid == memberUid &&
            getAfter(groupPath()).data.ownerId == request.auth.uid &&
            getAfter(groupPath()).data.memberCount == 1) ||
           (request.auth.uid == memberUid && publicGroup() &&
            validIncrementForMember(memberUid)) ||
           (isGroupManager() && privateGroup() &&
            exists(requestPath(memberUid)) &&
            get(requestPath(memberUid)).data.uid == memberUid &&
            !existsAfter(requestPath(memberUid)) &&
            validIncrementForMember(memberUid)));
        allow delete: if signedIn() &&
          (request.auth.uid == resource.data.uid &&
             validDecrementForMember(memberUid) ||
           isGroupManager());
        allow update: if false;
      }

      match /join_requests/{requesterUid} {
        allow read: if signedIn() &&
          (request.auth.uid == requesterUid || isGroupManager());
        allow create: if signedIn() && request.auth.uid == requesterUid &&
          get(groupPath()).data.visibility == 'private' &&
          !exists(memberPath(requesterUid)) &&
          request.resource.data.keys().hasOnly(['uid', 'displayName', 'createdAt']) &&
          request.resource.data.uid == requesterUid &&
          request.resource.data.displayName is string &&
          request.resource.data.createdAt == request.time;
        allow delete: if signedIn() &&
          (request.auth.uid == requesterUid || isGroupManager());
        allow update: if false;
      }

      match /posts/{groupPostId} {
        allow read: if isGroupMember() || isGroupOwner();
        allow create: if isGroupMember() &&
          request.resource.data.keys().hasAll([
            'authorId', 'authorName', 'content', 'createdAt', 'mediaType'
          ]) &&
          request.resource.data.keys().hasOnly([
            'authorId', 'authorName', 'content', 'createdAt', 'mediaType',
            'mediaPath', 'thumbnailPath'
          ]) &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.authorName is string &&
          request.resource.data.content is string &&
          request.resource.data.content.size() <= 1000 &&
          (request.resource.data.content.size() > 0 || request.resource.data.mediaType != 'none') &&
          request.resource.data.mediaType in ['none', 'image', 'video'] &&
          request.resource.data.createdAt == request.time &&
          ((request.resource.data.mediaType == 'none' &&
            !('mediaPath' in request.resource.data) &&
            !('thumbnailPath' in request.resource.data)) ||
           (request.resource.data.mediaType == 'image' &&
            request.resource.data.mediaPath is string &&
            request.resource.data.mediaPath.matches(
              'group_media/' + groupId + '/' + groupPostId + '/' + request.auth.uid + '/[^/]+'
            ) && !('thumbnailPath' in request.resource.data)) ||
           (request.resource.data.mediaType == 'video' &&
            request.resource.data.mediaPath is string &&
            request.resource.data.mediaPath.matches(
              'group_media/' + groupId + '/' + groupPostId + '/' + request.auth.uid + '/[^/]+'
            ) &&
            (!('thumbnailPath' in request.resource.data) ||
             request.resource.data.thumbnailPath.matches(
               'group_media/' + groupId + '/' + groupPostId + '/' + request.auth.uid + '/[^/]+'
             ))));
        allow update: if false;
        allow delete: if isGroupMember() &&
          (resource.data.authorId == request.auth.uid ||
           get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid);

        match /reactions/{reactorUid} {
          allow read: if isGroupMember() || isGroupOwner();
          allow create, update: if isGroupMember() && request.auth.uid == reactorUid &&
            request.resource.data.keys().hasOnly(['uid', 'reaction', 'updatedAt']) &&
            request.resource.data.uid == request.auth.uid &&
            request.resource.data.reaction in ['like', 'dislike'] &&
            request.resource.data.updatedAt == request.time;
          allow delete: if isGroupMember() &&
            (request.auth.uid == reactorUid ||
             get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid);
        }
      }
    }

  }
}
