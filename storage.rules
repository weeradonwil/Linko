// กฎ Storage แยก path ของสื่อโพสต์กับสื่อแชทและตรวจชนิด/ขนาดไฟล์ก่อนอัปโหลด
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ใช้กติกาเดียวกันกับไฟล์แนบทุกชนิด: ภาพไม่เกิน 10 MiB, วิดีโอไม่เกิน 50 MiB
    function isValidMediaUpload() {
      return request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType.matches('(image|video)/.*')
        && (
          (request.resource.contentType.matches('image/.*')
            && request.resource.size <= 10 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*')
            && request.resource.size <= 50 * 1024 * 1024)
        );
    }

    match /post_media/{ownerUid}/{postId}/{fileName} {
      function postDocument() {
        return /databases/(default)/documents/posts/$(postId);
      }
      function ownerProfile() {
        return /databases/(default)/documents/users/$(ownerUid);
      }

      function shareGrantPath() {
        return /databases/(default)/documents/posts/$(postId)/share_access/$(request.auth.uid);
      }
      function groupShareMediaAccess(grant) {
        let groupPath = /databases/(default)/documents/groups/$(grant.targetId);
        let sharePath = /databases/(default)/documents/groups/$(grant.targetId)/posts/$(grant.shareId);
        return firestore.exists(groupPath) &&
          firestore.get(groupPath).data.get('isDeleting', false) != true &&
          firestore.exists(/databases/(default)/documents/groups/$(grant.targetId)/members/$(request.auth.uid)) &&
          firestore.exists(sharePath) &&
          firestore.get(sharePath).data.get('sharedPostId', '') == postId &&
          firestore.get(sharePath).data.authorId == ownerUid;
      }
      function chatShareMediaAccess(grant) {
        let roomPath = /databases/(default)/documents/conversations/$(grant.targetId);
        let sharePath = /databases/(default)/documents/conversations/$(grant.targetId)/messages/$(grant.shareId);
        return firestore.exists(roomPath) &&
          request.auth.uid in firestore.get(roomPath).data.participantIds &&
          firestore.exists(sharePath) &&
          firestore.get(sharePath).data.type == 'post' &&
          firestore.get(sharePath).data.get('sharedPostId', '') == postId &&
          firestore.get(sharePath).data.senderId == ownerUid;
      }
      function validShareMediaGrant(grant) {
        return grant.ownerId == ownerUid && grant.expiresAt > request.time &&
          firestore.get(postDocument()).data.userId == ownerUid &&
          firestore.get(postDocument()).data.visibility == 'public' &&
          firestore.get(postDocument()).data.get('isDeleting', false) != true &&
          !firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/blocks/$(ownerUid)) &&
          !firestore.exists(/databases/(default)/documents/users/$(ownerUid)/blocks/$(request.auth.uid)) &&
          ((grant.destination == 'group' && groupShareMediaAccess(grant)) ||
           (grant.destination == 'chat' && chatShareMediaAccess(grant)));
      }
      function canReadSharedMedia() {
        return firestore.exists(postDocument()) && firestore.exists(shareGrantPath()) &&
          validShareMediaGrant(firestore.get(shareGrantPath()).data);
      }

      // เจ้าของจัดการไฟล์ของตัวเองได้; ผู้ใช้คนอื่นอ่านได้เฉพาะไฟล์ของโพสต์สาธารณะ
      // Firebase Console อาจขอเปิดการเชื่อมต่อ Rules ระหว่าง Storage กับ Firestore
      allow read: if request.auth != null &&
        (request.auth.uid == ownerUid ||
         (firestore.exists(postDocument()) &&
          firestore.get(postDocument()).data.userId == ownerUid &&
          firestore.get(postDocument()).data.get('authorIsPrivate', false) == false &&
          firestore.exists(ownerProfile()) &&
          firestore.get(ownerProfile()).data.get('privacyMigrationTarget',
            firestore.get(ownerProfile()).data.get('privacyTarget',
              firestore.get(ownerProfile()).data.get('isPrivate', false))) != true &&
          (firestore.get(postDocument()).data.visibility == 'public' ||
           (firestore.get(postDocument()).data.visibility == 'followers' &&
            firestore.exists(/databases/(default)/documents/users/$(ownerUid)/followers/$(request.auth.uid))))) ||
         canReadSharedMedia());

      // เจ้าของลบไฟล์ได้; การอัปโหลดต้องผ่าน MIME type และขนาดใน isValidMediaUpload()
      allow write: if request.auth != null &&
        (request.auth.uid == ownerUid ||
         (request.resource == null && request.auth.token.get('admin', false) == true)) &&
        (request.resource == null || isValidMediaUpload());
    }

    // หลักฐานเขียนได้จาก backend เท่านั้น และคนรายงานไม่เห็นหลักฐานของคนอื่น
    match /moderation_evidence/{caseKey}/{revision}/{fileName} {
      function caseDocument() { return /databases/(default)/documents/moderation_cases/$(caseKey); }
      allow read: if request.auth != null && firestore.exists(caseDocument()) &&
        (firestore.get(caseDocument()).data.ownerId == request.auth.uid ||
         firestore.get(caseDocument()).data.groupOwnerId == request.auth.uid);
      allow write: if false;
    }

    // สมาชิกที่ล็อกอินอ่านได้เฉพาะรูปปกปัจจุบัน แม้บัญชียังเป็นส่วนตัว
    match /profile_covers/{ownerUid}/{fileName} {
      function profile() { return /databases/(default)/documents/users/$(ownerUid); }
      allow read: if request.auth != null && firestore.exists(profile()) &&
        (request.auth.uid == ownerUid ||
         firestore.get(profile()).data.get('coverPath', '') ==
           'profile_covers/' + ownerUid + '/' + fileName);
      allow write: if request.auth != null && request.auth.uid == ownerUid &&
        (request.resource == null || (request.resource.size <= 5 * 1024 * 1024 && request.resource.contentType == 'image/png'));
    }

    match /group_media/{groupId}/{postId}/{ownerUid}/{fileName} {
      function groupPath() {
        return /databases/(default)/documents/groups/$(groupId);
      }
      function isGroupMember() {
        return firestore.exists(/databases/(default)/documents/groups/$(groupId)/members/$(request.auth.uid));
      }
      function isGroupManager() {
        return request.auth.token.get('admin', false) == true ||
          (firestore.exists(groupPath()) && firestore.get(groupPath()).data.ownerId == request.auth.uid);
      }
      allow read: if request.auth != null && (isGroupMember() || isGroupManager()) &&
        firestore.exists(/databases/(default)/documents/groups/$(groupId)/posts/$(postId)) &&
        firestore.get(/databases/(default)/documents/groups/$(groupId)/posts/$(postId)).data.authorId == ownerUid;
      allow write: if request.auth != null &&
        ((request.resource == null && (request.auth.uid == ownerUid || isGroupManager())) ||
         (request.resource != null && request.auth.uid == ownerUid && isGroupMember() &&
          firestore.exists(groupPath()) &&
          firestore.get(groupPath()).data.get('isDeleting', false) != true && isValidMediaUpload()));
    }

    // Group avatars are editable by the owner and readable by signed-in members.
    match /group_images/{groupId}/{ownerUid}/{fileName} {
      function groupDocument() {
        return /databases/(default)/documents/groups/$(groupId);
      }
      // Group avatars are discoverable with group metadata; private posts/media
      // remain protected by the separate group_media rule.
      allow read: if request.auth != null && firestore.exists(groupDocument());
      allow write: if request.auth != null && request.auth.uid == ownerUid &&
        firestore.exists(groupDocument()) &&
        firestore.get(groupDocument()).data.ownerId == request.auth.uid &&
        (request.resource == null ||
         (firestore.get(groupDocument()).data.get('isDeleting', false) != true &&
          request.resource.size <= 5 * 1024 * 1024 &&
          request.resource.contentType.matches('image/.*')));
    }

    // ไฟล์แชทอ่านได้เฉพาะสมาชิกของห้อง; เขียนได้เฉพาะผู้ส่งที่เป็นเจ้าของไฟล์
    // ขนาดและ MIME type ต้องสอดคล้องกับข้อจำกัดใน ChatService
    match /chat_media/{conversationId}/{ownerUid}/{fileName} {
      function conversationHasMember() {
        return firestore.exists(/databases/(default)/documents/conversations/$(conversationId)) &&
          request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participantIds;
      }
      allow read: if request.auth != null && conversationHasMember();
      // สมาชิกอัปโหลดหรือลบไฟล์ของตนเองได้ โดยใช้ขีดจำกัดเดียวกับสื่อในโพสต์
      allow write: if request.auth != null && request.auth.uid == ownerUid && conversationHasMember() &&
        (request.resource == null || isValidMediaUpload());
    }

    // The full image is visible to other signed-in users only while this
    // account is public. Profile cards use the separate small preview below.
    match /profile_images/{ownerUid}/{fileName} {
      function profile() { return /databases/(default)/documents/users/$(ownerUid); }
      allow read: if request.auth != null &&
        (request.auth.uid == ownerUid ||
         (firestore.exists(profile()) &&
          firestore.get(profile()).data.get('isPrivate', true) == false &&
          firestore.get(profile()).data.get('privacyMigrationTarget', false) != true &&
          firestore.get(profile()).data.get('privacyTarget', false) != true &&
          firestore.get(profile()).data.get('avatarPath', '') ==
            'profile_images/' + ownerUid + '/' + fileName));
      allow write: if request.auth != null &&
        request.auth.uid == ownerUid &&
        (request.resource == null ||
          (request.resource.size <= 5 * 1024 * 1024 &&
           request.resource.contentType.matches('image/.*')));
    }

    match /profile_thumbnails/{ownerUid}/{fileName} {
      function profile() { return /databases/(default)/documents/users/$(ownerUid); }
      allow read: if request.auth != null && firestore.exists(profile()) &&
        (request.auth.uid == ownerUid ||
         firestore.get(profile()).data.get('avatarThumbPath', '') ==
           'profile_thumbnails/' + ownerUid + '/' + fileName);
      allow write: if request.auth != null && request.auth.uid == ownerUid &&
        (request.resource == null ||
         (request.resource.size <= 1024 * 1024 && request.resource.contentType == 'image/png'));
    }

  }
}
